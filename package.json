{
  "name": "@thebuoyant-tsdev/mui-ts-library",
  "version": "3.26.0",
  "private": false,
  "description": "Type-safe React component library for MUI v9. Gantt chart with drag & drop, WYSIWYG rich text editor (TipTap), SQL & JSON code editors (CodeMirror 6), D3 data visualizations (Sunburst, Chord, RadialTree, CirclePacking, HorizontalTree, RadialStackedBar), tag selector, password strength meter, and a color picker. Full TypeScript, dark mode, i18n.",
  "author": {
    "name": "Thomas Schlender",
    "email": "thebuoyant@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/thebuoyant/mui-ts-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebuoyant/mui-ts-library.git"
  },
  "bugs": {
    "url": "https://github.com/thebuoyant/mui-ts-library/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "react-19",
    "typescript",
    "mui",
    "material-ui",
    "mui-v9",
    "mui-components",
    "material-design",
    "component-library",
    "ui-library",
    "ui-components",
    "react-components",
    "dark-mode",
    "theming",
    "i18n",
    "a11y",
    "storybook",
    "gantt",
    "gantt-chart",
    "react-gantt",
    "project-management",
    "project-timeline",
    "task-management",
    "timeline",
    "milestones",
    "drag-and-drop",
    "resizable",
    "virtualization",
    "dependency-chart",
    "critical-path",
    "rich-text-editor",
    "wysiwyg",
    "tiptap",
    "prosemirror",
    "text-editor",
    "markdown",
    "emoji-picker",
    "table-editor",
    "sql-editor",
    "sql",
    "codemirror",
    "codemirror-6",
    "code-editor",
    "syntax-highlighting",
    "sql-autocomplete",
    "postgresql",
    "mysql",
    "sqlite",
    "json-editor",
    "json-viewer",
    "json-formatter",
    "json-validator",
    "json-schema",
    "tag-input",
    "tag-selector",
    "multi-select",
    "autocomplete",
    "chip-input",
    "password-strength",
    "password-strength-meter",
    "password-validator",
    "d3",
    "d3-chart",
    "d3-visualization",
    "data-visualization",
    "data-viz",
    "chart",
    "charts",
    "react-chart",
    "hierarchy",
    "hierarchical-data",
    "sunburst",
    "sunburst-chart",
    "chord-diagram",
    "chord-chart",
    "circle-packing",
    "bubble-chart",
    "radial-tree",
    "radial-chart",
    "tree-chart",
    "horizontal-tree",
    "tree-diagram",
    "org-chart",
    "dashboard",
    "analytics",
    "color-picker",
    "color-palette",
    "radial-stacked-bar-chart",
    "stacked-bar-chart",
    "mention",
    "mention-input"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "prepublishOnly": "npm run test:run && npm run build",
    "pack-release": "npm run build && mkdir -p releases && npm pack --pack-destination releases/",
    "release": "bash scripts/release.sh",
    "npm-deploy": "bash scripts/npm-deploy.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook-docker": "bash scripts/build-storybook-docker.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
